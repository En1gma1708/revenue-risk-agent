# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# --- LLM providers (all free tier, no billing) ---
LLM_PROVIDER=gemini

# Each key can be a SINGLE key, or a COMMA-SEPARATED LIST of keys from multiple free accounts
# (different emails) to multiply real daily quota when running the full batch. E.g.:
#   GROQ_API_KEY=key_from_account_1,key_from_account_2
# run_batch.py automatically spreads load across every account configured this way.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Razorpay test-mode ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
