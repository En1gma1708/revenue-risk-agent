# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# --- LLM providers (all free tier, no billing) ---
LLM_PROVIDER=groq

# Each key can be a SINGLE key, or a COMMA-SEPARATED LIST of keys from multiple free accounts
# (different emails) to multiply real daily quota when running the full batch. E.g.:
#   GROQ_API_KEY=key_from_account_1,key_from_account_2
# run_batch.py automatically spreads load across every account configured this way.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Razorpay test-mode ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Langfuse (tracing/evals, free tier, no billing) ---
# Sign up at cloud.langfuse.com, create a project, copy the keys from Settings -> API Keys.
# Optional -- if unset, tracing is silently skipped, nothing else in the project depends on it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region depends on where your Langfuse project was created (US/EU/JP cloud, or self-hosted) --
# check your project's own dashboard URL, don't assume the default.
LANGFUSE_HOST=https://cloud.langfuse.com
